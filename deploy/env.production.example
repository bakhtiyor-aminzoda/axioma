# ==============================================================================
# Axioma Production Environment Configuration (.env)
# ==============================================================================

# Core Application Settings
INSTALLATION_NAME=Axioma
BRAND_NAME=Axioma
BRAND_URL=https://axioma.tj
WIDGET_BRAND_URL=https://axioma.tj
DEFAULT_LOCALE=tg
FRONTEND_URL=https://crm.axioma.tj

# Environment
RAILS_ENV=production
NODE_ENV=production

# Security (Generate with: openssl rand -hex 64)
SECRET_KEY_BASE=generate_with_openssl_rand_hex_64

# Database Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=chatwoot_production
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here

# Redis Configuration
REDIS_URL=redis://:your_secure_redis_password_here@redis:6379
REDIS_PASSWORD=your_secure_redis_password_here

# Axioma Production Image Version (Immutable release tag or git SHA, e.g. v0.1.0 or 7ed141d)
# NEVER use 'latest' in production to prevent unexpected breaking changes on container restart.
AXIOMA_IMAGE_TAG=v0.1.0

# Storage: Local disk for MVP, or S3-compatible (Cloudflare R2 / AWS S3 / MinIO) for commercial SaaS
ACTIVE_STORAGE_SERVICE=local
# For Cloudflare R2 / AWS S3:
# ACTIVE_STORAGE_SERVICE=s3_compatible
# STORAGE_ACCESS_KEY_ID=your_r2_access_key_id
# STORAGE_SECRET_ACCESS_KEY=your_r2_secret_access_key
# STORAGE_REGION=auto
# STORAGE_BUCKET_NAME=axioma-media-production
# STORAGE_ENDPOINT=https://<your_account_id>.r2.cloudflarestorage.com
# STORAGE_FORCE_PATH_STYLE=true

# SSRF Security: ALWAYS keep false in production.
# Prevents webhooks / avatar fetchers from accessing localhost (127.0.0.1),
# cloud metadata (169.254.169.254), or internal Docker network containers (postgres, redis).
SAFE_FETCH_ALLOW_PRIVATE_NETWORK=false

# WhatsApp Evolution API Integration (Community QR Gateway)
EVOLUTION_API_KEY=your_evolution_api_key_here
EVOLUTION_SERVER_URL=http://localhost:8080

# Mailer (Optional for MVP, required for password resets & invites)
# MAILER_SENDER_EMAIL=support@axioma.tj
# SMTP_ADDRESS=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USERNAME=apikey
# SMTP_PASSWORD=your_smtp_key_here
# SMTP_AUTHENTICATION=plain
# SMTP_ENABLE_STARTTLS_AUTO=true
