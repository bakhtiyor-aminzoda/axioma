# ==============================================================================
# Axioma Production Environment Configuration (.env)
# ==============================================================================

# Core Application Settings
INSTALLATION_NAME=Axioma
BRAND_NAME=Axioma
BRAND_URL=https://axioma.tj
WIDGET_BRAND_URL=https://axioma.tj
DEFAULT_LOCALE=tg
FRONTEND_URL=https://app.axioma.tj

# Environment
RAILS_ENV=production
NODE_ENV=production

# Security (Generate with: openssl rand -hex 64)
SECRET_KEY_BASE=axioma_super_secret_key_base_change_in_production_2026_production_key!

# Database Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=chatwoot_production
POSTGRES_USER=postgres
POSTGRES_PASSWORD=AxiomaSecurePass2026!

# Redis Configuration
REDIS_URL=redis://:AxiomaRedis2026!@redis:6379
REDIS_PASSWORD=AxiomaRedis2026!

# Storage
ACTIVE_STORAGE_SERVICE=local

# WhatsApp Evolution API Integration
EVOLUTION_API_KEY=AxiomaEvolutionKey2026!
EVOLUTION_API_URL=http://localhost:8080
