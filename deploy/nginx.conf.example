# ==============================================================================
# Nginx Configuration for Axioma (with WebSocket / ActionCable support)
# Location: /etc/nginx/sites-available/axioma
# ==============================================================================

upstream axioma_app {
    server 127.0.0.1:3000 fail_timeout=0;
}

upstream evolution_app {
    server 127.0.0.1:8080 fail_timeout=0;
}

server {
    listen 80;
    server_name app.axioma.tj;

    # Redirect all HTTP to HTTPS
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name app.axioma.tj;

    # SSL Certificates (obtained via certbot --nginx -d app.axioma.tj)
    # ssl_certificate /etc/letsencrypt/live/app.axioma.tj/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/app.axioma.tj/privkey.pem;

    client_max_body_size 64M;
    underscores_in_headers on;

    # Compression for speed in Tajikistan
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript image/svg+xml;

    location / {
        proxy_pass http://axioma_app;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket ActionCable Support
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 86400;
    }
}
